# ============================================================
#  LUMINA BACKEND - Environment Configuration
#  Copy this file to `.env` and fill in the real values.
# ============================================================

FLASK_ENV=development
FLASK_DEBUG=1

# --- Security keys (WAJIB diganti di production) -------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key

# --- Database ------------------------------------------------
# SQLite (default dev)  : sqlite:///lumina.db
# PostgreSQL            : postgresql+psycopg://user:pass@localhost:5432/lumina
# MySQL                 : mysql+pymysql://user:pass@localhost:3306/lumina
DATABASE_URL=sqlite:///lumina.db

# --- JWT lifetimes -------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Email / SMTP --------------------------------------------
# Gmail: aktifkan 2FA lalu buat "App Password" 16 karakter
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=yourname@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_SENDER_NAME=LUMINA
MAIL_SENDER_EMAIL=yourname@gmail.com
# 1 = jangan benar-benar kirim email (mode dev, kode tampil di console)
MAIL_SUPPRESS_SEND=0
# 1 = kirim email di background thread (request lebih cepat)
MAIL_ASYNC=0

# --- OTP rules -----------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# --- Password rules ------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TTL_SECONDS=900

# --- Frontend (untuk link reset password di email) -----------
FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_PATH=/reset-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Google Sign-In ------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# --- Asisten AI (F6) -----------------------------------------
# Ambil API key di https://console.anthropic.com/settings/keys
# Kosongkan kalau belum punya: endpoint /api/assistant tetap hidup dan
# menjawab dengan narasi yang dirakit langsung dari indeks.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max — makin tinggi makin dalam penalarannya
AI_EFFORT=low
AI_MAX_TOKENS=16000
AI_TIMEOUT_SECONDS=30
