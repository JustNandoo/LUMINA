# ============================================================
#  LUMINA Frontend - Environment
#  Salin ke `.env` lalu sesuaikan.
# ============================================================

# Alamat backend Flask (luminaBackend).
# Di macOS port 5000 dipakai AirPlay, jadi backend dijalankan di 5050:
#   PORT=5050 .venv/bin/python app.py
VITE_API_BASE_URL=http://127.0.0.1:5050

# Google Sign-In (opsional).
# Kosongkan kalau belum punya -> tombol "Continue with Google" otomatis disembunyikan.
# Ambil dari https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
